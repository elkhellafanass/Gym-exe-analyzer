# --- Données et vidéos : JAMAIS sur GitHub (RGPD, personnes identifiables) ---
data/*
!data/own/
data/own/*
!data/own/.gitkeep
outputs/
*.mp4
*.mov
*.avi
*.mkv
*.webm
# Images extraites des vidéos du dataset (inspection) : personnes identifiables
docs/inspection/
# Captures de l'application : montrent un sujet du dataset (personne identifiable)
docs/figures/app_*.png

# --- Modèles téléchargés (MediaPipe .task) et modèles entraînés ---
models/*.task
models/*.joblib
# Exception validée : le classifieur entraîné (quelques Ko, indicateurs dérivés, aucune image)
# est versionné pour que l'app en ligne puisse l'utiliser.
!models/squat_classifier.joblib

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Streamlit (secrets locaux) ---
.streamlit/secrets.toml
